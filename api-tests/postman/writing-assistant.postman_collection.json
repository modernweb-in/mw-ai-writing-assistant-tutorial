        {
            "name": "02 - Validation",
            "item": [
                {
                    "name": "Invalid operation (expected 400)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"operation\": \"invalid\",\n  \"input\": \"Hello\",\n  \"tone\": \"professional\",\n  \"length\": \"medium\"\n}"
                        },
                        "url": "{{baseUrl}}/api/generate"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 429) {",
                                    "    pm.test('Rate limit applied - wait before retrying', function () {",
                                    "        pm.response.to.have.status(429);",
                                    "    });",
                                    "} else {",
                                    "    pm.test('Returns HTTP 400', function () {",
                                    "        pm.response.to.have.status(400);",
                                    "    });",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Empty input (expected 400)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"operation\": \"improve\",\n  \"input\": \"\",\n  \"tone\": \"professional\",\n  \"length\": \"medium\"\n}"
                        },
                        "url": "{{baseUrl}}/api/generate"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 429) {",
                                    "    pm.test('Rate limit applied - wait before retrying', function () {",
                                    "        pm.response.to.have.status(429);",
                                    "    });",
                                    "} else {",
                                    "    pm.test('Returns HTTP 400', function () {",
                                    "        pm.response.to.have.status(400);",
                                    "    });",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Input exceeds 12000 characters (expected 400)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.variables.set('longInput', 'A'.repeat(12001));"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 429) {",
                                    "    pm.test('Rate limit applied - wait before retrying', function () {",
                                    "        pm.response.to.have.status(429);",
                                    "    });",
                                    "} else {",
                                    "    pm.test('Returns HTTP 400 for input exceeding 12000 characters', function () {",
                                    "        pm.response.to.have.status(400);",
                                    "    });",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"operation\": \"generate\",\n  \"input\": \"{{longInput}}\",\n  \"tone\": \"professional\",\n  \"length\": \"medium\"\n}"
                        },
                        "url": "{{baseUrl}}/api/generate"
                    }
                }
            ]
        },
        {
            "name": "03 - Request Protection",
            "item": [
                {
                    "name": "Oversized request body (expected 413)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.variables.set('largeInput', 'A'.repeat(70 * 1024));"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 429) {",
                                    "    pm.test('Rate limit applied - wait before retrying', function () {",
                                    "        pm.response.to.have.status(429);",
                                    "    });",
                                    "} else {",
                                    "    pm.test('Oversized payload rejected with HTTP 413', function () {",
                                    "        pm.response.to.have.status(413);",
                                    "    });",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"operation\": \"generate\",\n  \"input\": \"{{largeInput}}\",\n  \"tone\": \"professional\",\n  \"length\": \"medium\"\n}"
                        },
                        "url": "{{baseUrl}}/api/generate"
                    }
                },
                {
                    "name": "Rate limit check (safe request)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{ invalid json"
                        },
                        "url": "{{baseUrl}}/api/generate"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 429) {",
                                    "    pm.test('Rate limit successfully enforced', function () {",
                                    "        pm.response.to.have.status(429);",
                                    "    });",
                                    "} else {",
                                    "    pm.test('Request reached JSON parsing - rate limit not reached yet', function () {",
                                    "        pm.response.to.have.status(400);",
                                    "    });",
                                    "}"
                                ]
                            }
                        }
                    ]
                }
            ]
        }
