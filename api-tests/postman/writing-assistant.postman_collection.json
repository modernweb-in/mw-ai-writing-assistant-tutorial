{
    "info": {
        "name": "Modern Web - AI Writing Assistant",
        "description": "API testing collection for the Modern Web AI Writing Assistant tutorial. Includes generation, validation, oversized payload, and rate-limit tests.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000"
        }
    ],
    "item": [
        {
            "name": "01 - Generation",
            "item": [
                {
                    "name": "Improve writing",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"operation\": \"improve\",\n  \"input\": \"i am writing this email to ask about the project status\",\n  \"tone\": \"professional\",\n  \"length\": \"medium\",\n  \"outputFormat\": \"paragraphs\"\n}"
                        },
                        "url": "{{baseUrl}}/api/generate"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 429) {",
                                    "    pm.test('Rate limit applied - wait before retrying', function () {",
                                    "        pm.response.to.have.status(429);",
                                    "    });",
                                    "} else {",
                                    "    pm.test('Returns HTTP 200', function () {",
                                    "        pm.response.to.have.status(200);",
                                    "    });",
                                    "    if (pm.response.code === 200) {",
                                    "        pm.test('Response contains generated content', function () {",
                                    "            const body = pm.response.json();",
                                    "            pm.expect(body.result).to.be.a('string').and.not.empty;",
                                    "        });",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
